# Server-only. Never prefix with VITE_. Never commit real values.
OPENROUTER_API_KEY=
GEMINI_API_KEY=
# Required on Vercel for durable embeddings. Neon pooled connection string.
# Without it, Vercel uses ephemeral memory and dense retrieval is disabled.
DATABASE_URL=
# Optional. Raises GitHub API rate limits for repository ingestion.
GITHUB_TOKEN=
# Optional: Jev (TypeSafe System One) second opinion on the grounding decision.
# Off by default; the system runs unchanged without these. When enabled, a
# confident refuse/clarify verdict can only tighten the lexical gate's
# "positive" - it can never upgrade a refusal.
JEV_DECISION=
TYPESAFE_API_KEY=
JEV_CONFIDENCE=
